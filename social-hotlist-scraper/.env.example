FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
# If the Feishu bot enables signature verification, fill this secret.
FEISHU_BOT_SECRET=

# Others can only open this link if it is reachable from their network.
# With only this PC, keep 127.0.0.1 for local viewing, or replace it with LAN / intranet tunnel URL later.
DASHBOARD_PUBLIC_URL=http://127.0.0.1:47831/

# Number of rows pushed for each source: TikTok/FastMoss video, Instagram, Amazon, FastMoss hotlist.
FEISHU_TOP_PER_PLATFORM=10
