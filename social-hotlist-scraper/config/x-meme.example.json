{
  "global": {
    "maxPostsPerTarget": 10,
    "maxRecordsPerPlatform": 50,
    "minCommentCount": 0,
    "minHotScore": 0,
    "delayMs": 1200,
    "outputDir": "./data/runs"
  },
  "tiktok": {
    "enabled": false,
    "targets": []
  },
  "instagram": {
    "enabled": false,
    "targets": []
  },
  "amazon": {
    "enabled": false,
    "targets": []
  },
