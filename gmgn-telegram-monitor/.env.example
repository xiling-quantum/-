GMGN_API_KEY=replace_with_your_gmgn_api_key
GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_ed25519_private_key\n-----END PRIVATE KEY-----"

TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_or_group_id

# Alternative sender mode: reuse a GramJS user session instead of Bot API.
# TELEGRAM_SEND_MODE=auto uses Bot API when token/chat id exist, otherwise user session.
TELEGRAM_SEND_MODE=auto
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
TELEGRAM_NOTIFY_TARGET=me
TELEGRAM_PROXY_URL=socks5://127.0.0.1:7897

# Optional but recommended in mainland China if GMGN or Telegram direct access times out.
# Your current Windows proxy appears to be http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

CHAIN=sol
POLL_INTERVAL_SECONDS=10
LIMIT=50
SIDE=all
MIN_AMOUNT_USD=
MAX_AMOUNT_USD=
WALLET_FILTER=
WALLET_ALIAS_FILE=data/wallet-aliases.json

DRY_RUN=false
STARTUP_SUPPRESS_EXISTING=true
MAX_MESSAGES_PER_POLL=20
STATE_FILE=data/state.json
SEEN_LIMIT=5000

NARRATIVE_ENABLED=true
NARRATIVE_SOURCE_PROJECT=D:/Vscode/x-meme-scraper
NARRATIVE_LOAD_SOURCE_ENV=true
NARRATIVE_CACHE_FILE=data/narrative-cache.json
NARRATIVE_CACHE_TTL_HOURS=72
NARRATIVE_MAX_PER_POLL=20
NARRATIVE_REQUESTS_PER_MINUTE=60
NARRATIVE_CONCURRENCY=2
NARRATIVE_METADATA_SOURCES=bitget_wallet_coininfo,dexscreener_profile,pumpfun,jupiter,solana_metaplex,ca_pages,ca_search
