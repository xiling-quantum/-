{
  "name": "x-meme-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent local dashboard for collecting meme-coin related X posts from configured bloggers.",
  "scripts": {
    "start": "node ./src/server.js",
    "start:meme": "powershell -NoProfile -Command \"$env:PORT='48932'; $env:APP_MODE='meme'; node ./src/server.js\"",
    "start:analysis": "powershell -NoProfile -Command \"$env:PORT='48933'; $env:APP_MODE='analysis'; node ./src/server.js\"",
    "scrape:browser": "node ./src/browser-scrape.js",
    "scrape:heyi": "node ./src/browser-scrape.js --user heyibinance --max 20",
    "x:import-cookies": "node ./src/import-x-cookies.js",
    "telegram:login": "node ./src/telegram-login.js",
    "telegram:scrape": "node ./src/telegram-scrape.js",
    "check": "node --check ./src/server.js && node --check ./src/browser-scrape.js && node --check ./src/import-x-cookies.js && node --check ./src/telegram-login.js && node --check ./src/telegram-scrape.js"
  },
  "dependencies": {
    "input": "^1.0.1",
    "playwright": "^1.56.0",
    "telegram": "^2.26.22"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
