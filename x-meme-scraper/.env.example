# Optional AI classification providers.
# Leave values empty to disable that provider.

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# DeepSeek OpenAI-compatible Chat Completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot OpenAI-compatible Chat Completions
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Default provider used when UI/API does not specify one: openai, deepseek, or kimi
AI_PROVIDER=openai

# Telegram MTProto scraping.
# Create api_id/api_hash at https://my.telegram.org/apps, then run npm run telegram:login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# Optional Telegram delivery for remote multi-device viewing.
# Use "me" to push matched results into Saved Messages, or use a username/chat/channel you can send to.
TELEGRAM_NOTIFY_TARGET=
TELEGRAM_NOTIFY_ENABLED=true

# Optional token metadata enrichment used by Telegram contract/special cards.
# Sources: bitget_wallet_coininfo,bitget_wallet_page,bitget_wallet,bitget_wallet_txinfo,dexscreener_profile,dexscreener_cto,dexscreener_ads,dexscreener_boost,dexscreener_boost_latest,pumpfun,geckoterminal,coingecko,coinmarketcap,solana_metaplex,ca_search
TOKEN_METADATA_ENABLED=true
TOKEN_METADATA_SOURCES=
TOKEN_CA_SEARCH_ENABLED=true
TOKEN_CA_SEARCH_MAX_RESULTS=3
TOKEN_CA_SEARCH_TIMEOUT_SECONDS=8
BITGET_WALLET_API_KEY=
BITGET_WALLET_API_SECRET=
BITGET_WALLET_WEB_API_BASE=https://api-web.bitkeep.fun
BITGET_WALLET_COININFO_LOCALE=zh-CN
BITGET_WALLET_COININFO_TIMEOUT_SECONDS=6
BITGET_WALLET_PAGE_LOCALES=zh-CN,en
BITGET_WALLET_PAGE_TIMEOUT_SECONDS=6
COINGECKO_API_KEY=
CMC_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
