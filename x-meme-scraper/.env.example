# Optional AI classification providers.
# Leave values empty to disable that provider.

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# DeepSeek OpenAI-compatible Chat Completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot OpenAI-compatible Chat Completions
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Default provider used when UI/API does not specify one: openai, deepseek, or kimi
AI_PROVIDER=openai

# Telegram MTProto scraping.
# Create api_id/api_hash at https://my.telegram.org/apps, then run npm run telegram:login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
